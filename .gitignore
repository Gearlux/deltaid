# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
env/
venv/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/

# IDEs
.vscode/
.idea/
.DS_Store

# Testing / Coverage
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage-*
coverage.xml
*test-report.xml

# Project-Specific (Data & Logs)
lightning_logs/
checkpoints/
*.ckpt
*.pt
*.pth
# Everything a sweep (`matrainer sweep`) writes: per-run logs, the file-backed trackers, the
# SavedModel export and the huggingface Trainer's output_dir all land under one tree on purpose.
sweep_logs/
hf_runs/
# The run manifest's own tree. `RunManifest` falls back to `runs/<experiment>/<run>` when nothing
# sets `run_dir` (matrainer's `tracking/manifest.py`), which is independent of a tracker's
# `save_dir` — so a sweep writes here as well as under `sweep_logs/`.
runs/

# Linter outputs
isort-checkstyle.xml
isort-diff.txt
black-checkstyle.xml
black-diff.txt
flake8.txt
mypy.txt

# logs
logs/
*.log
/pyrightconfig.json
